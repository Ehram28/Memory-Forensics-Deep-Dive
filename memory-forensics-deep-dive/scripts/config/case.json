{
  "case_id": "CASE-001",
  "analysis_host": {
    "volatility3_path": "volatility3",
    "rekall_path": "rekall",
    "python_bin": "python3"
  },
  "memory_images": {
    "windows": {
      "image_path": "memory_dumps/CASE-001/memory.raw",
      "profile": "auto"
    }
  },
  "output_root": ".",
  "plugins": {
    "volatility3": [
      "windows.info",
      "windows.pslist",
      "windows.psscan",
      "windows.pstree",
      "windows.dlllist",
      "windows.malfind",
      "windows.cmdline",
      "windows.netscan",
      "windows.handles",
      "windows.hashdump"
    ]
  },
  "suspicious_scoring": {
    "process_injection_terms": ["malfind", "WriteProcessMemory", "CreateRemoteThread"],
    "powershell_terms": ["-enc", "FromBase64String", "Invoke-Expression"],
    "credential_terms": ["lsass", "sekurlsa", "mimikatz"],
    "network_terms": ["beacon", "c2"]
  },
  "yara": {
    "rules_dir": "yara_rules",
    "scan_targets": ["extracted_artifacts/CASE-001"],
    "write_matches_to": "reports/CASE-001/yara_matches.json"
  }
}

